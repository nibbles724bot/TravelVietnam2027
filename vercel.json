{
  "rewrites": [
    {
      "source": "/",
      "destination": "/Vietnam_2027_Mobile_Itinerary.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
